# Marrow API - Environment Variables
# Copy to .env and fill in your values

# Database (Supabase direct connection string)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OpenAI (for embeddings)
OPENAI_API_KEY=sk-...

# API key for development (optional - used when no app-specific key is provided)
MARROW_DEV_API_KEY=marrow_dev_...
